{
    "compilerOptions": {
        "outDir": "./dist/",
        "rootDir": "./src",
        "module": "esnext",
        "resolveJsonModule": true,
        "sourceMap": true,
        "target": "es6",
        "lib": ["es2016", "dom", "dom.iterable", "webworker.importscripts", "scripthost"],
        "allowJs": true,
        "moduleResolution": "node",
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "esModuleInterop": true,
        "types": ["jest"],
        "removeComments": true,
        "ignoreDeprecations": "6.0"
    },
    "include": ["./src/**/*"],

    "exclude": ["./dist", "node_modules"]
}
