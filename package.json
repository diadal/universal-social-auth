{
  "name": "universal-social-auth",
  "version": "0.2.9",
  "description": "Social Authentication library for (SPA, PWA & App)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "unpkg": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./providers": {
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check-up": "npx npm-check-updates -u --reject typescript && npm install",
    "reload-git": "git rm -r --cached .  && git add .",
    "build": "vite build && npm run build:providers",
    "build:dev": "vite build --mode development && npm run build:providers:dev",
    "build:providers": "vite build --config vite.providers.config.ts",
    "build:providers:dev": "vite build --config vite.providers.config.ts --mode development",
    "preview": "vite preview",
    "catalog:generate": "node scripts/generate-provider-catalog.mjs",
    "catalog:check": "node scripts/generate-provider-catalog.mjs --check",
  "compat:check": "node scripts/compat-check.mjs",
  "dev": "npm --prefix docs-site run dev",
  "d:doc": "npm --prefix docs-site run build && npm --prefix docs-site run deploy",
    "test": "jest"
  },
  "keywords": [
    "vue",
    "vuejs",
    "auth",
    "laravel vue",
    "vue Social Login",
    "vue facebook",
    "vue google",
    "vue github",
    "vue vkontakte",
    "auth",
    "authentication",
    "login",
    "registration",
    "jwt",
    "token",
    "vue3",
    "vue.js",
    "react",
    "nodejs",
    "nodejs",
    "apply",
    "github",
    "facebook",
    "google",
    "twitter",
    "oauth",
    "oauth 1.0",
    "oauth 2.0",
    "laravel",
    "SPA Social Login"
  ],
  "author": {
    "name": "diadal",
    "email": "info@zintrust.com",
    "url": "https://zintrust.com"
  },
  "repository": "git:https://github.com/diadal/universal-social-auth.git",
  "license": "MIT",
  "tags": [
    "auth",
    "authentication",
    "login",
    "registration",
    "jwt",
    "token",
    "vue3",
    "vue.js",
    "react",
    "nodejs",
    "nodejs",
    "apply",
    "github",
    "facebook",
    "google",
    "twitter",
    "oauth",
    "oauth 1.0",
    "oauth 2.0",
    "laravel",
    "SPA Social Login"
  ],
  "bugs": {
    "url": "https://github.com/diadal/universal-social-auth/issues"
  },
  "homepage": "https://github.com/diadal/universal-social-auth",
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
