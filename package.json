{
  "name": "universal-social-auth",
  "version": "0.3.2",
  "description": "Social Authentication for web and PWA, with a Capacitor adapter for iOS/Android (device verification pending)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "unpkg": "dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./providers": {
      "import": {
        "types": "./dist/providers/index.d.mts",
        "default": "./dist/providers/index.mjs"
      },
      "require": {
        "types": "./dist/providers/index.d.cts",
        "default": "./dist/providers/index.js"
      }
    },
    "./capacitor": {
      "import": {
        "types": "./dist/adapters/capacitor/index.d.mts",
        "default": "./dist/capacitor/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/capacitor/index.d.cts",
        "default": "./dist/capacitor/index.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "check-up": "npx npm-check-updates -u --reject typescript && npm install",
    "reload-git": "git rm -r --cached .  && git add .",
    "gh:clear": "node scripts/gh-clear.mjs",
    "build": "vite build && npm run build:providers && npm run build:capacitor && npm run build:types",
    "build:dev": "vite build --mode development && npm run build:providers:dev && npm run build:capacitor:dev",
    "build:providers": "vite build --config vite.providers.config.ts",
    "build:providers:dev": "vite build --config vite.providers.config.ts --mode development",
    "build:capacitor": "vite build --config vite.capacitor.config.ts",
    "build:capacitor:dev": "vite build --config vite.capacitor.config.ts --mode development",
    "build:types": "tsc -p tsconfig.build.json && node scripts/prepare-types.mjs",
    "consumer:check": "node scripts/check-consumer-types.mjs",
    "prepack": "npm run build",
    "preview": "vite preview",
    "catalog:generate": "node scripts/generate-provider-catalog.mjs",
    "catalog:check": "node scripts/generate-provider-catalog.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs",
    "compat:check": "node scripts/compat-check.mjs && npm run consumer:check",
    "dev": "npm --prefix docs-site run dev",
    "d:doc": "npm --prefix docs-site run build && npm --prefix docs-site run deploy",
    "d:mcp": "npm --prefix mcp run deploy",
    "test": "jest"
  },
  "keywords": [
    "vue",
    "vuejs",
    "auth",
    "laravel vue",
    "vue Social Login",
    "vue facebook",
    "vue google",
    "vue github",
    "vue vkontakte",
    "auth",
    "authentication",
    "login",
    "registration",
    "jwt",
    "token",
    "vue3",
    "vue.js",
    "react",
    "nodejs",
    "nodejs",
    "apply",
    "github",
    "facebook",
    "google",
    "twitter",
    "oauth",
    "oauth 1.0",
    "oauth 2.0",
    "laravel",
    "social login",
    "capacitor",
    "ios",
    "android"
  ],
  "author": {
    "name": "diadal",
    "email": "info@zintrust.com",
    "url": "https://zintrust.com"
  },
  "repository": "git:https://github.com/diadal/universal-social-auth.git",
  "license": "MIT",
  "tags": [
    "auth",
    "authentication",
    "login",
    "registration",
    "jwt",
    "token",
    "vue3",
    "vue.js",
    "react",
    "nodejs",
    "nodejs",
    "apply",
    "github",
    "facebook",
    "google",
    "twitter",
    "oauth",
    "oauth 1.0",
    "oauth 2.0",
    "laravel",
    "social login",
    "capacitor",
    "ios",
    "android"
  ],
  "bugs": {
    "url": "https://github.com/diadal/universal-social-auth/issues"
  },
  "homepage": "https://github.com/diadal/universal-social-auth",
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3",
    "deepmerge": "4.3.1"
  }
}
